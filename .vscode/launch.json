{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    {
      "name": "Start Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}\\src\\server\\index.js",
    "cwd": "${workspaceFolder}\\src\\server",
      "console": "integratedTerminal"
    },
    {
      "name": "Start Client",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}\\src\\client\\client-app",
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug Vite + React",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}\\src\\client\\client-app",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Start Client and Server",
      "configurations": ["Start Server", "Start Client"]
    }

    ]
}