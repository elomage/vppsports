# Production Environment Variables
# Required for deployment

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sensor_data_db

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-strong-random-access-secret-here
JWT_REFRESH_SECRET=your-strong-random-refresh-secret-here

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecurePassword123!

# CORS Origins (comma-separated list)
# Include your production domain, e.g., https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://your-server-ip

# Server binding/public URL
HOST=0.0.0.0
SERVER_PUBLIC_URL=https://yourdomain.com

# Frontend build-time backend URL
VITE_SERVER_URL=https://yourdomain.com
